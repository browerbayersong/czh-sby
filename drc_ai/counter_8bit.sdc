set_load 0.000319342  [get_nets n4]
set_load 0.000279033  [get_nets n3]
set_load 0.000809318  [get_nets n1]
set_load 0.00127759  [get_nets en]
set_load 0.00130864  [get_nets rst_n]
set_load 4.4075e-07  [get_nets clk]
set_resistance 0.0792162  [get_nets clk]
