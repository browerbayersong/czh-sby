set_load 0.000258813  [get_nets n3]
set_load 0.00141021  [get_nets en]
set_load 0.00131856  [get_nets rst_n]
set_load 4.56052e-07  [get_nets clk]
set_resistance 0.0864167  [get_nets clk]
