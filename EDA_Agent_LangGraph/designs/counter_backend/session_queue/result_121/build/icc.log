EDA_ECO_HELP_BEGIN route_zrt_detail
 route_zrt_detail     # run zrt detail route
   [-incremental (false|true)]
                          (do incremental routing (default false))
   [-initial_drc_from_input (false|true)]
                          (Use the drcs in the cell as the initial drc if ture (default false))
   [-start_iteration <int>]
                          (start iteration for detail route (default 0): 
                           Range: 0 to 1000)
   [-max_number_iterations <int>]
                          (max number of detail route iterations (default 40): 
                           Range: 0 to 1000)
   [-coordinates <{{llx1 lly1} {urx1 ury1} ....}>]
                          (area routing bounding box(es))

EDA_ECO_HELP_END route_zrt_detail
EDA_ECO_HELP_BEGIN route_zrt_eco
 route_zrt_eco        # run zrt eco route
   [-nets <nets>]         (eco route the nets provided (with this option open net driven option is ignored))
   [-max_detail_route_iterations <int>]
                          (max number of detailed routing iterations: 
                           Range: 1 to 1000)
   [-utilize_dangling_wires (false|true)]
                          (utilize dangling wires (default true))
   [-reroute (any_nets|modified_nets_only|modified_nets_first_then_others)]
                          (reroute strategy to fix drc (default any_nets))
   [-max_reported_nets <int>]
                          (max number of changed nets to be reported (default 100). -1 means all nets changed by the command will be reported.: 
                           Range: -1 to 2147483647)
   [-open_net_driven (false|true)]
                          (check and fix drcs on open nets (default false). this options is ignored if -nets is specified.)
   [-reuse_existing_global_route (false|true)]
                          (do incremental routing in gr (default false))

EDA_ECO_HELP_END route_zrt_eco
