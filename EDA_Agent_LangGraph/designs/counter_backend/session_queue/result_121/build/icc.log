EDA_ECO_HELP_BEGIN create_route_guide
 create_route_guide   # Create route guide
   -coordinate rect       (route guide bounding box)
   [-no_signal_layers string]
                          (layers on which signal routing isn't allowed)
   [-no_preroute_layers string]
                          (layers on which preroute isn't allowed)
   [-preferred_direction_only_layers string]
                          (layers on which non-preferred wire isn't allowed)
   [-zero_min_spacing]    (allow zero min spacing)
   [-repair_as_single_sbox]
                          (repair as single sbox)
   [-horizontal_track_utilization percentage]
                          (horizontal track utilization: 
                           Range: 0 to 1000)
   [-vertical_track_utilization percentage]
                          (vertical track utilization: 
                           Range: 0 to 1000)
   [-track_utilization_layers string]
                          (layers on which track utilization will be set by horizontal_track_utilization or vertical_track_utilization)
   [-switch_preferred_direction_layers string]
                          (switch preferred direction on specified layers)
   [-name string]         (route guide name)
   [-access_preference string]
                          (Specifies varying degrees of wire/via access preference for router to connect to existing shapes in a given rectangular region)
   [-single_layer_routing string]
                          (layers on which single layer routing should be encouraged)
   [-max_number_of_pattern string]
                          ({layer1 number1 type1 layer2 number2 type2 ...})
   [-design_boundary_blockage string]
                          (layers on which router will follow design boundary blockage rules)

EDA_ECO_HELP_END create_route_guide
