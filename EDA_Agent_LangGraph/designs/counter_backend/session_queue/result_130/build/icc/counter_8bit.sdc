set_load 0.000206353  [get_nets n5]
set_load 0.000378436  [get_nets n4]
set_load 0.000322287  [get_nets n3]
set_load 0.0015954  [get_nets en]
set_load 0.00151324  [get_nets rst_n]
set_load 4.56052e-07  [get_nets clk]
set_resistance 0.0864167  [get_nets clk]
