EDA_HELP_BEGIN verify_lvs
 verify_lvs           # Detects LVS violations
   [-error_cell cell_name]
                          (Cell_name to save the error cell. Default: <current_cell_name>_lvs.err)
   [-ignore_floating_port]
                          (Do not check floating port. Default: check)
   [-ignore_floating_net] (Do not check floating net. Default: check)
   [-ignore_short]        (Do not check short. Default: check)
   [-ignore_open]         (Do not check open. Default: check)
   [-ignore_eeq_pin]      (Do not check EEQ Pin. Default: check)
   [-ignore_min_area]     (Do not check minimun area. Default: check)
   [-use_notch_gap_fill_cell]
                          (Use fill gap notch cell. Default: not use)
   [-ignore_blockage_overlap]
                          (Do not check blockage overlap. Default: check)
   [-check_single_pin_net_for_floating_port]
                          (Do check single pin net for floating port. Default: not check)
   [-check_single_pin_net_for_floating_net]
                          (Do check single pin net for floating net. Default: not check)
   [-check_floating_port_on_null_net]
                          (Do check floating port on null net. Default: not check)
   [-ignore_floating_metal_fill_net]
                          (Do not check floating metal fill. Default: check)
   [-check_short_locator] (Execute short locator. Default: do not execute)
   [-check_open_locator]  (Execute open locator. Default: do not execute)
   [-max_error ]          (Max number of error before exit. Default: 20)
   [-nets ]               (net collection to do verify_lvs. Default: None)
   [-exclude_nets ]       (net collection not to do verify_lvs. Default: None)
   [-ignore_metal_without_net_name]
                          (ignore checking vioation with metal without net name. Default: off)
   [-check_child_blockages]
                          (check short between child cell blockages and nets. Default: off)

EDA_HELP_END verify_lvs
