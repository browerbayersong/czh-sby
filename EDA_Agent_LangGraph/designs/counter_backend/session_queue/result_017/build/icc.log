EDA_HELP_BEGIN create_rectangular_rings
 create_rectangular_rings # create rectangular rings
   [-around core | specified | specified_as_group | all_macros_except_specified | rectangle]
                          (Creates rings around core, or specified in -cells, or within the rectangle. Default: core)
   [-cells {collection_of_cells}]
                          (collection of instances for -around specified | specified_as_group | all_macros_except_specified)
   [-within {{llx lly} {urx ury}}]
                          (Creates rings within the rectangle; for -around rectangle)
   -nets {collection_of_nets}
                          (Nets to create rectangular rings)
   [-skip_left_side]      (Does NOT create the left side of the ring)
   [-skip_right_side]     (Does NOT create the right side of the ring)
   [-skip_bottom_side]    (Does NOT create the bottom side of the ring)
   [-skip_top_side]       (Does NOT create the top side of the ring)
   [-left_segment_layer number_or_name]
                          (Layer to create left side of the ring. Default: first vertical layer)
   [-right_segment_layer number_or_name]
                          (Layer to create right side of the ring. Default: first vertical layer)
   [-bottom_segment_layer number_or_name]
                          (Layer to create bottom side of the ring. Default: first horizontal layer)
   [-top_segment_layer number_or_name]
                          (Layer to create top side of the ring. Default: first horizontal layer)
   [-left_segment_width distance]
                          (Creates ring of specified width on the left side. Default: minWidth for layer)
   [-right_segment_width distance]
                          (Creates ring of specified width on the right side. Default: minWidth for layer)
   [-bottom_segment_width distance]
                          (Creates ring of specified width on the bottom side. Default: minWidth for layer)
   [-top_segment_width distance]
                          (Creates ring of specified width on the top side. Default: minWidth for layer)
   [-offsets adjusted | absolute]
                          (Rings offsets adjusted for DRC or absolute (user specified). Default: adjusted)
   [-left_offset distance]
                          (Offset on the left side for -offsets absolute; Default: 0.0)
   [-right_offset distance]
                          (Offset on the right side for -offsets absolute; Default: 0.0)
   [-bottom_offset distance]
                          (Offset on the bottom side for -offsets absolute; Default: 0.0)
   [-top_offset distance] (Offset on the top side for -offsets absolute; Default: 0.0)
   [-extend_ll]           (Extends the left segment of the ring low)
   [-extend_lh]           (Extends the left segment of the ring high)
   [-extend_rl]           (Extends the right segment of the ring low)
   [-extend_rh]           (Extends the right segment of the ring high)
   [-extend_bl]           (Extends the bottom segment of the ring low (left))
   [-extend_bh]           (Extends the bottom segment of the ring high (right))
   [-extend_tl]           (Extends the top segment of the ring low (left))
   [-extend_th]           (Extends the top segment of the ring high (right))
   [-create_innermost_core_ring_conservatively]
                          (To assist cell placement. Works only with -around core)
   [-ignore_parallel_targets]
                          (Ignores parallel to rings targets for connection)
   [-extend_for_multiple_connections]
                          (Extends ring segments to reach more targets)
   [-extension_gap distance]
                          (Connect targets within gap space if extend_for_multiple_connections is set; distance>=0. Default: 0.0)
   [-advanced_via_rules]  (Use advanced via rules, set previously. Default: false)
   -undo                  (Undo the previous create_rectangular_rings. Supersedes all options)

EDA_HELP_END create_rectangular_rings
EDA_HELP_BEGIN preroute_standard_cells
 preroute_standard_cells # preroute_standard_cells
   [-mode rail | tie | net]
                          (Connect cells by rail (default) or by tieing PG pins to targets (without restrictions) or by connecting pins of a net to straps/rings with restrictions.)
   [-connect horizontal | vertical | both]
                          (Connect horizontally (default), vertically or in both directions)
   [-nets {collection_of_nets}]
                          (Nets to route; If not specified, uses PG nets by default)
   [-route_pins_on_layer number_or_name]
                          (Connects only pins on specified layer. Default: on all layers)
   [-start_share_via_stack name of metal layer]
                          (Shared vias are allowed above this layer. Default: no shared vias allowed)
   [-within {{llx lly} {urx ury}}]
                          (Working area; if not specified uses top cell bbox)
   [-ignore_cell_boundary]
                          (Keeps out-of-bound std rails. Default: false)
   [-no_routing_outside_working_area]
                          (Prevent connections outside working area. Default: false)
   [-special_via_rule]    (Use special vias instead of a large one at intersections. Will need to specify offsets, sizes and steps. Default: false)
   [-offset_both_sides_for_special_via]
                          (Special via offsets applied both to lower left and upper right side. Default: lower left only)
   [-special_via_x_offset distance]
                          (X offset from lower-left corner; distance>0.  Default: 0.0)
   [-special_via_y_offset distance]
                          (Y offset from lower-left corner; distance>0.  Default: 0.0)
   [-special_via_x_size distance]
                          (Width of special via; distance>0. Default: 0.0)
   [-special_via_y_size distance]
                          (Height of special via; distance>0. Default: 0.0)
   [-special_via_x_step distance]
                          (X distance between special vias; distance>0. Default: 0.0)
   [-special_via_y_step distance]
                          (Y distance between special vias; distance>0. Default: 0.0)
   [-advanced_via_rules]  (Use advanced via rules, set previously. Default: false)
   [-skip_macro_pins]     (Do not connect to macro pins)
   [-skip_pad_pins]       (Do not connect to pad pins)
   [-remove_floating_pieces]
                          (Remove floating (unconnected) rail segments. Default: keep)
   [-pin_width_by_extreme_edges]
