EDA_HELP_BEGIN create_mw_lib
 create_mw_lib        #  Create a milkyway library 
   [-technology file_name]
                          (Technology file name)
   [-bus_naming_style bus_naming_style]
                          (Bus naming style)
   [-mw_reference_library lib_list]
                          (List of reference libraries)
   [-reference_control_file file_name]
                          (Reference control file)
   [-open]                (Open the library after creation)
   libName                (Library name to create)

EDA_HELP_END create_mw_lib
EDA_HELP_BEGIN import_designs
 import_designs       # import_designs
   -format <files>        (Format of import design)
   [-top design name]     (Top design name)
   [-cell cell name]      (The cell name.)
   [-rp_constraint rp_constraint script file name]
                          (rp_constraint script file name.)
   file_list              (list of files to import)

EDA_HELP_END import_designs
EDA_HELP_BEGIN create_floorplan
 create_floorplan     # create floorplan
   [-control_type control type]
                          (default is aspect_ratio: 
                           Values: aspect_ratio, width_and_height, 
                           boundary)
   [-core_aspect_ratio float]
                          (core aspect ratio, default is 1)
   [-core_utilization float]
                          (core utilization, default is 0.7)
   [-core_width float]    (width, default is 1)
   [-core_height float]   (height, default is 1)
   [-use_vertical_row]    (use vertical rows, default is horizontal)
   [-no_double_back]      (no double back)
   [-start_first_row]     (start first row)
   [-flip_first_row]      (flip first row)
   [-left_io2core float]  (left space between io to cell, default is 0)
   [-right_io2core float] (right space between io to cell, default is 0)
   [-bottom_io2core float]
                          (bottom space between io to cell, default is 0)
   [-top_io2core float]   (top space between io to cell, default is 0)
   [-keep_macro_place]    (keep preplaced macro cells)
   [-keep_std_cell_place] (keep preplaced standard cells)
   [-min_pad_height]      (set the core area based on the minimum pad height)
   [-pad_limit]           (place pads with no spaces in between)
   [-keep_io_place]       (keep placement of terminals or pads)

EDA_HELP_END create_floorplan
EDA_HELP_BEGIN create_fp_placement
 create_fp_placement  # Virtual flat placement
   [-effort string]       (effort, default is Low: 
                           Values: Low, High)
   [-max_fanout integer]  (maximum fanout, default is 512)
   [-no_hierarchy_gravity]
                          (turn off hierarchy gravity)
   [-no_legalize]         (Resulting placement will not be legalized)
   [-incremental string]  (start from current placement (default is full placement): 
                           Values: all, top_level_cells, plan_groups, 
                           voltage_areas)
   [-congestion_driven]   (Congestion driven placement)
   [-timing_driven]       (Timing driven placement)
   [-num_cpus integer]    (Number of CPUs used in parallel during coarse placement, default is 1)
   [-plan_groups collection of plan groups]
                          (collection of plan groups for incremental refine placement)
   [-voltage_areas collection of voltage areas]
                          (collection of voltage areas for incremental refine placement)
   [-optimize_pins]       (Simultaneous pin assignment and placement)
   [-consider_scan]       (Consider scan chain connectivity during placement)
   [-write_placement_blockages]
                          (Dump placement blockages into a file)
   [-exploration]         (Exploration mode placement)

EDA_HELP_END create_fp_placement
EDA_HELP_BEGIN place_opt
 place_opt            # Run place_opt
   [-effort string]       (low | medium | high (default is medium))
   [-area_recovery]       (enable area recovery)
   [-optimize_dft]        (Reorder scan during placement)
   [-consider_scan]       (consider scan chain connections during placement)
   [-continue_on_missing_scandef]
