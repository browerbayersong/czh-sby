   [-clock_trees <collection_or_string_list>]
                          (list of clock names or collection of clock objects)
   [-fix_hold_all_clocks] (perform hold-time violation fixing for all clocks.)
   [-optimize_dft]        (perform scan reordering.)
   [-power]               (perform post cts power optimization.)
   [-area_recovery]       (perform area recovery.)
   [-size_only]           (perform sizing only in post CTS optimization.)
   [-congestion]          (perform congestion minimization.)
   [-only_hold_time]      (run hold timing optimization only in post CTS optimization.)
   [-in_place_size_only]  (perform in place sizing only in post CTS optimization.)
   [-continue_on_missing_scandef]
                          (continue with missing scandef)

EDA_HELP_END clock_opt
