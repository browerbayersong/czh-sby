EDA_POWER_HELP_BEGIN create_net_shape
 create_net_shape     # Create net shape
   [-type net_shape_type] (net shape type: 
                           Values: wire, path, rect, poly)
   -origin point          (origin of the net shape for wires)
   -bbox rect             (bounding box of the net shape for rects)
   -points recti_path     (points of the net shape for paths)
   -boundary boundary     (boundary of net shape for polygon)
   [-length float]        (length of the net shape for wires)
   [-width float]         (width of the net shape for wires)
   [-path_type path_type] (alignment type of a wire or path end: 
                           Values: square, round, extend_half_width, 
                           octagon, 0, 1, 2, 3)
   -layer layer           (layer of the net shape)
   -net string            (net of the net shape)
   [-vertical]            (indicates that the wire is vertical (default horizontal))
   [-route_type route_type]
                          (route type of the net shape: 
                           Values: user_enter, signal_route, 
                           signal_route_global, signal_route_detail, 
                           pg_ring, pg_strap, pg_macro_io_pin_conn, 
                           pg_std_cell_pin_conn, clk_ring, clk_strap, 
                           clk_zero_skew_route, bus, shield, 
                           shield_fixed, shield_dynamic, fill_track, 
                           clk_fill_track)
   [-datatype int_range]  (datatype number: 
                           Range: 0 to 4095)
   [-mask_constraint mask_constraint]
                          (patterning mask constraint: 
                           Values: any_mask, mask1_soft, mask1_hard, 
                           mask2_soft, mask2_hard, same_mask, 
                           mask3_soft, mask3_hard)
   [-avoid_short_segment] (avoid segment shorter than half_width for paths)

EDA_POWER_HELP_END create_net_shape
EDA_POWER_HELP_BEGIN create_via
