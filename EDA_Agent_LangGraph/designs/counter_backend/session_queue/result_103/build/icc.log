EDA_POWER_HELP_BEGIN create_power_straps
 create_power_straps  # create power straps
   [-direction horizontal | vertical]
                          (Strap direction. Default: horizontal)
   [-start_at distance]   (Starting strap coordinate; Y for horizontal or X for vertical. Default: 0.0)
   [-start_at_offset distance]
                          (Starting strap coordinate; Y for horizontal or X for vertical. Coordinate should be treated as offset from left/bottom corner of bounding box of each voltage area, specified in the option -within_voltage_areas or -exclude_voltage_areas Default: N/A)
   -undo                  (Undo the previous create_power_straps. Supersedes all options)
   -nets {collection_of_nets}
                          (Collection of nets to create the straps; required!)
   [-layer number_or_name]
                          (Layer number or layer name, ex: 31 or M1. Default: first horizontal or vertical layer for specified direction)
   [-width distance]      (Creates straps of specified width. Default: defaultWidth of layer)
   [-configure groups_and_step | groups_and_stop | step_and_stop | rows | macros]
                          (Place strap based on specified option. Default: groups_and_step)
   [-num_groups integer]  (Number of strap groups to be created. Default: 1)
   [-step distance]       (Distance from reference strap of one group to reference strap of adjacent group; not used with -groups_and_stop. Default: 0.0)
   [-stop distance]       (Location to stop the strap placement; not used with -groups_and_step. Default: 0.0)
   [-pitch_within_group distance]
                          (Distance between center lines of two adjacent straps within the same group. Default: pitch of layer)
   [-start_low_ends boundary | first_targets | coordinate | last_targets | offset]
                          (Place low strap ends based on specified option. Default: boundary)
   [-start_low_ends_coordinate distance]
                          (Place low strap ends at specified coordinate. Default: 0.0)
   [-start_high_ends boundary | first_targets | coordinate | last_targets | offset]
                          (Place high strap ends based on specified option. Default: boundary)
   [-start_high_ends_coordinate distance]
                          (Place high strap ends at specified coordinate. Default: 0.0)
   [-extend_low_ends to_first_target | to_boundary_and_generate_pins | force_to_boundary_and_generate_pins | off]
                          (Extend low strap ends based on specified option. Default: to_first_target)
   [-extend_high_ends to_first_target | to_boundary_and_generate_pins | force_to_boundary_and_generate_pins | off]
                          (Extend high strap ends based on specified option. Default: to_first_target)
   [-num_placement_strap integer]
                          (Number of times strap groups to be placed, value>=1. Default: 1)
   [-increment_x_or_y distance]
                          (Horizontal/vertical  distance between the first and the subsequent straps, when num_placement_strap is more than 1. Default: 0.0)
   [-special_via_rule]    (Use special vias instead of a large one at intersections. Will need to specify offsets, sizes and steps. Default: false)
   [-offset_both_sides_for_special_via]
                          (Special via offsets applied both to lower left and upper right side. Default: lower left only)
   [-special_via_x_offset distance]
                          (X offset from lower-left corner; distance > 0. Default: 0.0)
   [-special_via_y_offset distance]
                          (Y offset from lower-left corner; distance > 0. Default: 0.0)
   [-special_via_x_size distance]
                          (Width of special via; distance > 0. Default: 0.0)
   [-special_via_y_size distance]
                          (Height of special via; distance > 0. Default: 0.0)
   [-special_via_x_step distance]
                          (X distance between special vias; distance > 0. Default: 0.0)
   [-special_via_y_step distance]
                          (Y distance between special vias; distance > 0. Default: 0.0)
   [-advanced_via_rules]  (Use advanced via rules, set previously. Default: false)
   [-look_inside_std_cells]
                          (Creates vias to connect straps to pins in standard cells. Default: false)
   [-std_cells Collection of cells]
                          (Creates vias to connect straps to pins in these standard cells only. Default: all cells)
   [-keep_floating_wire_pieces]
                          (Keep floating (unconnected) segments. Default: false)
   [-ignore_cell_boundary]
                          (Keeps out-of-bound straps. Default: false)
   [-clip_at_top_cell_boundaries]
                          (Cuts the straps at the top cell boundaries, useful in rectilinear design. Default: false)
   [-do_not_merge_targets]
                          (Target objects are not merged before the connections are created. Default: false)
   [-optimize_wire_locations]
                          (Adjusts straps by small distances to save tracks for detail route. Default: false)
   [-ignore_parallel_targets]
                          (Ignores parallel to straps targets for connection. Default: false)
   [-define_parallel_targets_by_wire_directions]
                          (Parallel targets are defined by their wire directions. Default: false)
   [-do_not_route_over_macros]
                          (Prevents generating wires over the macro cells. Default: false)
   [-extend_for_multiple_connections]
                          (Extends the low and high ends of the strap to connect more targets on the same net. Default: false)
   [-extension_gap distance]
                          (Connect targets within gap space if extend_for_multiple_connections is set; distance >= 0. Default: 0.0)
   [-mark_as_std_cell_pin_connections]
                          (Marks the created PG straps as "std conn" instead of "strap" type. Default: false)
   [-mark_as_ring]        (Marks the created PG straps as "ring" instead of "strap" type. Default: false)
   [-special_rules string]
                          (Refers to a set of special rules specified by the command set_preroute_special_rules)
   [-detour_required]     (Turn on detour feature, additional options required. Default: no detour)
   [-detour_nets {collection_of_nets}]
                          (Collection of nets that straps detour will be applied. When specified, no detours will be created for other nets. Default: all nets)
   [-detour_jog_length_limit {max_length_north max_length_south}]
                          (Restrictions of jog length for auto-detour. Both values should be non-negative. Zero vlaue means auto-detour is not allowed in that direction.Default: both values are zeroes, no auto-detour)
   [-detour_jog_offset distance]
                          (Distance between jog of auto-detour and obstruction. Default: 0)
   [-detour_enforce {jog_length jog_offset}]
                          (Specify jog behavior for enforced-detour. Jog length is represented by signed value where positive value for north-bound jog and negative vlaue for south-bound. Default: both values are zeroes, no enforced-detour)
   [-detour_accept_all]   (Accept enforced detour even it is not DRC clean. Default: only accept DRC-clean detours)
   [-detour_region {{llx lly} {urx ury}}]
                          (Specify the only area where detours are allowed. Default: top cell bounding box)
   [-detour_snap_on_track]
                          (Place the central line of detour's main shape on routing track of the strap's layer.Default: no snapping)
   [-detour_leading_obstructions]
                          (Detour over leading obstruction if it can find target on the detour route. Default: no detour over leading obstruction)
   -within_voltage_areas {Collection of voltage areas}
                          (The only voltage area(s), where straps should be created. Default: all voltage areas in design)
   -exclude_voltage_areas {Collection of voltage areas}
                          (Voltage area(s), where straps should not be created. Default: empty voltage area)

EDA_POWER_HELP_END create_power_straps
