# 从项目目录执行：copy .env.example code/.env，然后填入真实密钥。
# .env 已在 .gitignore 中排除。

# OpenAI 配置（国外用户）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek 配置（国内用户推荐）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：deepseek-v4-pro（更强）或 deepseek-flash（更便宜/更快，支持视觉输入）
DEEPSEEK_MODEL=deepseek-v4-pro

# 虚拟机配置；地址请替换为自己的虚拟机 IP，不要填写 SSH 密码。
EDA_SSH_HOST=
EDA_REMOTE_BASE=/home/IC/Desktop/EDA_Projects

# 可选：会话存储目录。留空时优先使用已有 C:\LangGraph_talk，
# 新机器默认存放在本项目 data/，无需写入 C 盘根目录。
EDA_DATA_DIR=
