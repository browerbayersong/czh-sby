---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	inspect(inspect)
	plan(plan)
	make(make)
	review(review)
	repair(repair)
	final(final)
	__end__([<p>__end__</p>]):::last
	__start__ --> inspect;
	inspect --> plan;
	make -.-> review;
	plan -. &nbsp;stop&nbsp; .-> __end__;
	plan -.-> make;
	repair --> review;
	review -.-> final;
	review -.-> repair;
	final --> __end__;
	make -.-> make;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
